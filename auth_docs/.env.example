# Auth Picture Configuration
# Copy to .env and adjust values

# --- Paths ---
UPLOAD_DIR=uploads
OUTPUT_DIR=output
CERTS_DIR=certs
HF_CACHE_DIR=.hf_cache

# --- Database ---
DATABASE_URL=sqlite:///./auth_picture.db

# --- AI Detection ---
AI_THRESHOLD=0.5
AI_MODEL_1=umm-maybe/AI-image-detector
AI_MODEL_2=Organika/sdxl-detector

# --- Watermark / Protection ---
WATERMARK_STRENGTH=10.0
ROBUST_LEVEL=medium
PROMPT_TEXT=DO NOT MODIFY WITH AI

# --- Adversarial ---
PGD_ENABLED=false
PGD_EPSILON=0.03
PGD_STEPS=10
PGD_ALPHA=0.005

# --- C2PA ---
C2PA_CLAIM_GENERATOR=AuthPicture/0.2.0

# --- Audio ---
AUDIO_HMAC_SECRET=change_me_in_production
AUDIO_DWT_WAVELET=db4
AUDIO_DWT_LEVEL=3
AUDIO_QIM_DELTA=50.0
AUDIO_REPEAT=11

# --- Server ---
HOST=0.0.0.0
PORT=8000
